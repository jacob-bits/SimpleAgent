{
  "llm": {
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY",
    "model": "gpt-4o-mini",
    "temperature": 0,
    "max_tokens": 1024,
    "timeout_seconds": 60
  },
  "agent": {
    "min_steps": 1,
    "max_steps": 8,
    "max_repeated_actions": 2,
    "no_progress_threshold": 0.95,
    "no_progress_min_chars": 80,
    "max_history_chars": 200000,
    "timeout_seconds": 120,
    "verbose": false
  },
  "tools": {
    "allowed_root": ".",
    "max_file_bytes": 65536
  }
}
